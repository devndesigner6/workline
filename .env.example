# Optional hosting overrides — everything else lives in agenc.config.ts.

# Override the gPA fallback RPC endpoint (defaults per network).
# Server-side RPC override (kept private when the provider uses an API key).
# AGENC_RPC_URL=
# Browser RPC override (RPC URLs and public API keys are visible to clients).
# NEXT_PUBLIC_AGENC_RPC_URL=

# The hosted-indexer API key (X-Agenc-Api-Key). Anonymous reads work without it.
# AGENC_API_KEY=
